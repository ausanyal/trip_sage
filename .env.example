# Optional: Gemini API key for LLM-powered conversational planning & structured TripSpec extraction.
# When omitted, TripSage falls back gracefully to its built-in deterministic NLP parser + live OSRM/OSM solver.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional (Recommended for Public Launch): SerpApi key for live Google Hotels, Vacation Rentals (Airbnb/VRBO)
# & Google Flights checkout pricing, verified property photos, and direct OTA deep links.
# Get a key at https://serpapi.com/ — when omitted, TripSage transparently badges rates as Parametric Market Benchmarks.
SERPAPI_API_KEY=

# Optional: Custom path for SQLite HTTP TTL cache & shareable trip permalinks database.
# Defaults to backend/data/tripsage.db
TRIPSAGE_DB_PATH=
